{
  "name": "jichikai-sasae-ai",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "自治会運営AI支援（仮称）。Cloudflare Workers の上で動く運営支援システム。",
  "scripts": {
    "dev": "wrangler dev",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts/tsconfig.json",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:staging": "wrangler d1 migrations apply DB --remote",
    "dev-vars": "node scripts/make-dev-vars.ts",
    "put-secrets": "node scripts/put-secrets.ts",
    "open-ward": "node scripts/open-ward.ts",
    "walkthrough": "node scripts/walkthrough.ts",
    "walkthrough-rest": "node scripts/walkthrough-rest.ts",
    "walkthrough-meeting": "node scripts/walkthrough-meeting.ts",
    "screens": "node scripts/screens.ts",
    "check-screens": "node scripts/check-screens.ts",
    "line-sim": "node scripts/line-sim.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.4.0",
    "hono": "^4.13.16",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.23.0",
    "@cloudflare/workers-types": "^5.20261104.1",
    "@types/node": "^24.19.2",
    "jsqr": "^1.4.0",
    "playwright": "^1.56.1",
    "typescript": "~5.9.3",
    "vitest": "^4.1.0",
    "wrangler": "^4.157.0"
  }
}
